{
  "name": "pages",
  "displayName": "Pages",
  "version": "0.0.20",
  "description": "Syntax Highlighting for HTML and JavaScript in Page files",
  "categories": [
    "Linters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/plushveil/pages.git"
  },
  "publisher": "plushveil",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "npm run lint:format && npm run lint:lint",
    "lint:format": "oxfmt",
    "lint:lint": "oxlint --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run -s build && npm run -s test:lint && npm run -s test:format && npm run -s typecheck && npm run -s test:unit",
    "test:lint": "oxlint",
    "test:format": "oxfmt --check",
    "test:unit": "node --test test/**/*.test.js",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@plushveil/pages": "^0.0.101",
    "@typescript/typescript6": "^6.0.2",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Pages Configuration",
      "properties": {
        "pages.suggestions": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable text suggestions."
        },
        "pages.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable diagnostics."
        },
        "pages.formatting": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable formatting."
        }
      }
    },
    "languages": [
      {
        "id": "pages",
        "extensions": [
          ".htms",
          ".page"
        ],
        "aliases": [
          "Page"
        ],
        "configuration": "./pages.language.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pages",
        "scopeName": "source.pages",
        "path": "./pages.textmate.json"
      }
    ],
    "snippets": [
      {
        "language": "pages",
        "path": "./pages.snippets.json"
      }
    ],
    "commands": [
      {
        "command": "pages.serve",
        "title": "Run Pages Development Server in Workspace"
      }
    ]
  },
  "engines": {
    "vscode": "^1.144.0"
  }
}
