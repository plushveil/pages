{
  "workspaceFolder": "/workspace",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "workspace",
  "forwardPorts": [8000],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/direnv:1": {}
  },
  "postCreateCommand": "direnv allow && npm ci",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": ["ms-vscode-remote.remote-containers", "GitHub.copilot", "GitHub.copilot-chat", "oxc.oxc-vscode"]
    }
  }
}
