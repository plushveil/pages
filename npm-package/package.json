{
  "name": "@plushveil/pages",
  "version": "0.0.92",
  "keywords": [
    "engine",
    "html",
    "pages",
    "render",
    "template"
  ],
  "license": "SEE LICENSE IN LICENSE FILE",
  "author": "Plushveil <plushveil@gray.blue>",
  "bin": {
    "pages": "dist/bin/pages.js"
  },
  "type": "module",
  "main": "dist/src/pages.js",
  "types": "dist/src/pages.d.ts",
  "scripts": {
    "build": "npm run -s build:types",
    "prepack": "npm run -s build",
    "build:types": "tsc -p tsconfig.build.json",
    "pages": "cli_from_jsdoc",
    "lint": "npm run lint:format && npm run lint:lint",
    "lint:format": "oxfmt",
    "lint:lint": "oxlint --fix",
    "test": "npm run build && npm run test:lint && npm run test:format && npm run test:types && npm run test:unit",
    "test:lint": "oxlint",
    "test:format": "oxfmt --check",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "test:unit": "NODE_OPTIONS=--experimental-strip-types mocha --config tests/mocha.json"
  },
  "dependencies": {
    "@plushveil/cli_from_jsdoc": "^0.0.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript/typescript6": "^6.0.2",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.5.4",
    "css-select": "7.0.0",
    "cssnano": "^8.0.2",
    "glob": "^13.0.6",
    "mime": "^4.1.0",
    "postcss": "^8.5.25",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^8.0.1",
    "rolldown": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "c8": "^12.0.0",
    "mocha": "^11.8.0",
    "neostandard": "^0.13.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@rolldown/binding-wasm32-wasi": "1.2.2"
  },
  "overrides": {
    "c8": {
      "yargs": "^18.0.0"
    }
  }
}
