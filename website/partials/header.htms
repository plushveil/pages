<header class="w-full bg-slate-700 text-slate-100 py-2 border-b-[2px] border-slate-700 relative after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1px] after:bg-white/30">
  <nav class="mx-auto container">
    <ul role="list" class="flex space-x-2 md:space-x-6 mx-auto md:mx-0 w-fit">
      <li>
        <a href="${homepage.href}" class="block rounded-xl px-6 py-2 text-base md:text-xl lg:text-3xl text-gray-200 hover:text-gray-200 ${homepage.active ? active : inactive}">
          ${homepage.title}
        </a>
      </li>
      <li>
        <a href="${articles.gettingstarted.href}" class="block rounded-xl px-6 py-2 text-base md:text-xl lg:text-3xl text-gray-200 hover:text-gray-200 ${articles.gettingstarted.active ? active : inactive}">
          ${articles.gettingstarted.text.short_title}
        </a>
      </li>
      <li>
        <a href="${articles.essentials.href}" class="block rounded-xl px-6 py-2 text-base md:text-xl lg:text-3xl text-gray-200 hover:text-gray-200 ${articles.essentials.active ? active : inactive}">
          ${articles.essentials.text.short_title}
        </a>
      </li>
      <li>
        <a href="${articles.examples.href}" class="block rounded-xl px-6 py-2 text-base md:text-xl lg:text-3xl text-gray-200 hover:text-gray-200 ${articles.examples.active ? active : inactive}">
          ${articles.examples.text.short_title}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script target="header">
  import { getArticleTranslations } from '../articles/articles.mjs'
  import page from 'page:page'
  import config from 'page:config'
  import translations from '../translations.mjs'
  export const lang = page.params?.languageId || 'en'
  export const articles = getArticleTranslations(lang, config.baseURI, page.url.href)
  export const text = translations[lang]

  export const active = 'bg-slate-600'
  export const inactive = ''

  const homepageUrl = new URL(lang, config.baseURI)
  export const homepage = {
    title: text.title,
    href: homepageUrl.toString(),
    active: page.url.pathname === homepageUrl.pathname
  }
</script>
