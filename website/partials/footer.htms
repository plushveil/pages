<footer class="mt-[30vh] min-h-[70vh] bg-slate-700 border-t-[2px] border-slate-700 relative before:absolute before:top-0 before:left-0 before:w-full before:h-[1px] before:bg-white/30">
  <div class="mx-auto max-w-7xl px-6 pt-16 pb-8 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <a class="block" href="${homepage.href}">
          <img class="h-9" src="../favicon.ico" alt="${text.title}">
        </a>
        <p class="text-sm/6 text-balance text-gray-200">${text.description}</p>
        <div class="flex gap-x-6">
          <a href="${text.resources.github.href}" class="text-gray-200 hover:text-gray-300">
            <span class="sr-only">${text.resources.github.title}</span>
            <svg class="size-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm/6 font-semibold text-gray-200">${text.resources.title}</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="${text.resources.github.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${text.resources.github.title}</a>
              </li>
              <li>
                <a href="${text.resources.npm.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${text.resources.npm.title}</a>
              </li>
              <li>
                <a href="${text.resources.vscode.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${text.resources.vscode.title}</a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm/6 font-semibold text-gray-200">${text.community.title}</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="${text.community.ticket.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${text.community.ticket.title}</a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm/6 font-semibold text-gray-200">${text.title}</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="${homepage.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${homepage.title}</a>
              </li>
              <li>
                <a href="${articles.gettingstarted.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.gettingstarted.text.title}</a>
              </li>
              <li>
                <a href="${articles.essentials.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.essentials.text.title}</a>
              </li>
              <li>
                <a href="${articles.examples.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.examples.text.title}</a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm/6 font-semibold text-gray-200">${text.legal.title}</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="${articles.terms.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.terms.text.title}</a>
              </li>
              <li>
                <a href="${articles.policy.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.policy.text.title}</a>
              </li>
              <li>
                <a href="${articles.impressum.href}" class="text-sm/6 text-gray-200 hover:text-gray-200">${articles.impressum.text.title}</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-gray-200/10 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-sm/6 text-gray-200">&copy; ${(new Date()).getFullYear()}&nbsp;${text.title}. ${text.legal.rights}</p>
    </div>
  </div>
</footer>

<script target="footer">
  import { getArticleTranslations } from '../articles/articles.mjs'
  import translations from '../translations.mjs'
  import page from 'page:page'
  import config from 'page:config'
  export const lang = page.params?.languageId || 'en'
  export const articles = getArticleTranslations(lang, config.baseURI, page.url.href)
  export const text = translations[lang]
  const homepageUrl = new URL(lang, config.baseURI)
  export const homepage = { title: text.home.short_title, href: homepageUrl.toString() }
</script>
