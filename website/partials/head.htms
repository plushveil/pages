<meta charset="UTF-8">
${title ? `<title>${title}</title>` : ''}
<link rel="icon" href="../favicon.ico" type="image/x-icon">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="../style.css">
<script src="../script.js" async></script>
${description ? `<meta name="description" content="${description}">` : ''}
<script>
  const colorScheme = localStorage.getItem('prefers-color-scheme') || ((window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light')
  document.documentElement.classList.add(colorScheme)
</script>

<script target="title">
  import args from 'page:args'
  export const title = args.title
  export const description = args.description
</script>
